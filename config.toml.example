# go-ispconfig — Configuration Example
#
# Copy this file to config.toml and customize the values for your environment,
# or generate it with:
#
#     go-ispconfig init
#
# Search order: --config flag → ./config.toml → /etc/go-ispconfig/config.toml
#
# All settings can also be overridden using environment variables with the
# GOISP_ prefix. Example: GOISP_SERVER_PORT=9000 go-ispconfig serve
#
# Only static process configuration lives here. Runtime server behavior
# (web/dns settings per server) stays in the database, editable from the panel.

[server]
host = "0.0.0.0"
port = 8080
# HTTPS is the default: with no certificate configured below, a 10-year
# self-signed certificate is generated into ssl/ next to this file and
# reused on later starts. Set https = false for plain HTTP (no certificate
# is generated then).
https = true
# Explicit certificate/key pair (e.g. from Let's Encrypt). When set, the
# files are used as-is and never overwritten: an invalid or expired pair is
# a startup error.
tls_cert = ""
tls_key  = ""
# Serve the Swagger UI (/swagger) without authentication. Default false:
# the UI and the OpenAPI spec require an admin session.
swagger_public = false
# CIDRs of reverse proxies allowed to set X-Forwarded-For/X-Forwarded-Proto.
# Requests from these addresses use the forwarded client IP for login lockout
# and the forwarded proto for the Secure cookie flag. Empty = headers ignored.
# Example: trusted_proxies = ["127.0.0.1/32", "10.0.0.0/8"]
trusted_proxies = []

[database]
# MariaDB/MySQL DSN. The database must be the ISPConfig3 schema (dbispconfig);
# `go-ispconfig migrate` creates it on an empty database.
dsn = "root:@tcp(127.0.0.1:3306)/dbispconfig?charset=utf8mb4&parseTime=True&loc=Local"
# Client-DB admin credentials file (TOML, mode 0600, root-owned) used by the
# daemon database module to provision client MySQL databases — the
# go-ispconfig equivalent of ISPConfig's server/lib/mysql_clientdb.conf:
#
#     clientdb_host = "localhost"
#     clientdb_port = 3306
#     clientdb_user = "goisp_clientdb"
#     clientdb_password = "secret"
#
# The user needs only client-DB administration privileges (CREATE/DROP
# DATABASE, CREATE USER, GRANT OPTION, read of mysql.user) — never root.
# clientdb_conf = "/etc/go-ispconfig/mysql_clientdb.conf"
#
# Panel-wide database behavior stays in the getconf global [sites] section
# (sys_ini, editable from the panel), not here. Keys consumed by this module:
# dbname_prefix, dbuser_prefix, phpmyadmin_url, default_dbserver,
# default_remote_dbserver, disable_client_remote_dbserver.

[daemon]
# Interval between sys_datalog processing cycles.
tick_seconds = 10
# Processed sys_datalog rows older than this many days are removed by the
# daily pruning job (03:00, internal scheduler).
datalog_retention_days = 30
# Module enablement gates (also require the matching server.*_server = 1
# flag on the local server row). Default false = module loads when the
# server role is set.
# disable_mail_module = false
# disable_firewall_module = false
# disable_database_module = false
# Emergency: stop client_delete teardown events.
# disable_client_events = false

[queue]
# Redis/Valkey backing the asynq task queue (scheduler jobs, instant datalog
# wake, per-server job routing). The queue transports work, never state:
# sys_datalog remains the source of truth, so with Redis down the daemon
# keeps applying changes via tick polling and writes only log a warning.
addr = "localhost:6379"
db = 0
password = ""

[templates]
# Directory checked before the embedded .master templates: a file here with
# the same name overrides the embedded one (ISPConfig3 conf-custom parity).
# Manage it with: go-ispconfig templates list / export <name> | --all
custom_dir = "/etc/go-ispconfig/templates-custom"

[auth]
# Re-hash legacy ISPConfig crypt password hashes ($6$/$1$) to bcrypt on login.
# Keep false until a migration cutover from PHP ISPConfig is final: PHP cannot
# verify bcrypt, so enabling this breaks the documented rollback path.
rehash_legacy = false
