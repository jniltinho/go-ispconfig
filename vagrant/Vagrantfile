# -*- mode: ruby -*-
# vi: set ft=ruby :
#
# Test rig for the go-ispconfig installer (openspec add-installer-cli, D11)
# plus the standing legacy lab (openspec add-legacy-test-lab).
#
#   ubuntu (default)         bento/ubuntu-24.04  192.168.56.10  go-ispconfig panel (nginx)
#   debian (opt-in)          bento/debian-12     192.168.56.11  go-ispconfig panel (nginx)
#   apache-test (opt-in)     bento/ubuntu-24.04  192.168.56.22  go-ispconfig panel (apache2)
#   legacy (lab)             bento/ubuntu-24.04  192.168.56.20  PHP ISPConfig3 nginx (full stack: mail+Roundcube)
#   legacy-apache (lab)      bento/ubuntu-24.04  192.168.56.21  PHP ISPConfig3 apache2 (full stack: mail+Roundcube)
#
# `legacy` and `legacy-apache` are STANDING LAB machines (see vagrant/lab/):
# `make vagrant-destroy` never touches them — destroy explicitly with
# `vagrant destroy -f legacy legacy-apache` only when reprovisioning.
#
# `make vagrant-up` builds the linux/amd64 binary first; provisioning copies
# it into the guest and runs `go-ispconfig install --yes` with fixed answers.

INSTALL = <<~SHELL
  set -e
  install -m 0755 /tmp/go-ispconfig /usr/local/bin/go-ispconfig
  /usr/local/bin/go-ispconfig install --yes --write-credentials \
    --hostname "$1" --admin-email admin@goisp.test --web-server "$2"
SHELL

# Fixed legacy panel credentials for the lab/parity tests (test rig only).
LEGACY_ADMIN_PW  = "GoIspParity2026"   # panel admin on both legacy VMs
LEGACY_REMOTE_PW = "GoIspRemote2026"   # remote-API user `goisp-lab` (full grants)

Vagrant.configure("2") do |config|
  config.vm.provider "virtualbox" do |vb|
    vb.memory = 4096
    vb.cpus = 2
  end
  # No synced folder: the file provisioner copies what the guests need.
  config.vm.synced_folder ".", "/vagrant", disabled: true

  { "ubuntu"      => ["bento/ubuntu-24.04", "192.168.56.10", "nginx",   true],
    "debian"      => ["bento/debian-12",    "192.168.56.11", "nginx",   false],
    "apache-test" => ["bento/ubuntu-24.04", "192.168.56.22", "apache2", false],
  }.each do |name, (box, ip, web, default)|
    config.vm.define name, primary: default, autostart: default do |m|
      m.vm.box = box
      m.vm.hostname = "#{name}.goisp.test"
      m.vm.network "private_network", ip: ip
      m.vm.provision "file", source: "../bin/go-ispconfig-linux-amd64",
                             destination: "/tmp/go-ispconfig"
      m.vm.provision "shell", inline: INSTALL, args: ["#{name}.goisp.test", web]
    end
  end

  # Standing legacy PHP ISPConfig3 lab VMs (parity baseline + migration source,
  # read/write playground — full stack: web + bind + mail + Roundcube).
  { "legacy"        => ["192.168.56.20", "nginx"],
    "legacy-apache" => ["192.168.56.21", "apache"] }.each do |name, (ip, web)|
    config.vm.define name, autostart: false do |m|
      m.vm.box = "bento/ubuntu-24.04"
      m.vm.hostname = "#{name}.goisp.test"
      m.vm.network "private_network", ip: ip
      m.vm.provider "virtualbox" do |vb|
        vb.memory = 6144   # full stack (postfix/dovecot/rspamd/clamav) needs headroom
        vb.cpus = 2
      end
      m.vm.provision "shell", path: "provision-legacy.sh",
                              env: { "ADMIN_PW"   => LEGACY_ADMIN_PW,
                                     "REMOTE_PW"  => LEGACY_REMOTE_PW,
                                     "WEB_SERVER" => web,
                                     "PANEL_IP"   => ip }
    end
  end
end
