[Unit]
Description=go-ispconfig panel (API + embedded SPA)
Documentation=https://github.com/jniltinho/go-ispconfig
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=simple
# The panel never touches the OS (design D1) beyond its own config
# directory: it reads/writes the database and maintains the auto-generated
# TLS certificate under /etc/go-ispconfig/ssl (design D13), so it runs as a
# fixed unprivileged user (created by the installer) instead of
# DynamicUser, which could not own files across restarts.
User=go-ispconfig
Group=go-ispconfig
ExecStart=/usr/local/bin/go-ispconfig serve --config /etc/go-ispconfig/config.toml
Restart=on-failure
RestartSec=5

# Hardening. ProtectSystem=strict makes the filesystem read-only; the
# config directory is re-exposed and only its ssl/ subdirectory is writable
# (auto-generated panel certificate, design D13).
#
# NoNewPrivileges and an empty CapabilityBoundingSet are deliberately NOT
# set: both stop setuid sudo from working, and the fail2ban page needs
# `sudo fail2ban-client status` because fail2ban's control socket is
# root-only. The escalation surface is the /etc/sudoers.d/go-ispconfig-fail2ban
# whitelist (status + unbanip), not the whole system.
ProtectSystem=strict
ConfigurationDirectory=go-ispconfig
ReadWritePaths=/etc/go-ispconfig/ssl
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
